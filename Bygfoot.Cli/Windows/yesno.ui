<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name yesno.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="YesNoWindow" parent="GtkWindow">
    <property name="default-width">450</property>
    <property name="default-height">350</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_yesno_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox17">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkImage" id="image8">
            <property name="visible">1</property>
            <property name="icon-name">gtk-dialog-question</property>
            <property name="icon-size">6</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label_yesno">
            <property name="visible">1</property>
            <property name="wrap">1</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox18">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_yesno_yes">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Yes</property>
                <property name="icon-name">gtk-yes</property>
                <signal name="clicked" handler="on_button_yesno_yes_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_yesno_no">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">No</property>
                <property name="icon-name">gtk-no</property>
                <property name="tooltip-text" translatable="yes">Esc</property>
                <signal name="clicked" handler="on_button_yesno_no_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
