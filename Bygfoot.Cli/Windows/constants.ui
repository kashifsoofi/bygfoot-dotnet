<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name constants.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="ConstantsWindow" parent="GtkWindow">
    <property name="title" translatable="yes">Constants</property>
    <property name="default-width">650</property>
    <property name="default-height">600</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_constants_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox12">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkBox" id="hbox17">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="label26">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Your debt:</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_alr_debt">
                <property name="visible">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator7">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="height-request">10</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label22">
            <property name="visible">1</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">Current settings:</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="table2">
            <property name="visible">1</property>
            <child>
              <object class="GtkLabel" id="label23">
                <property name="visible">1</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Start in week:</property>
                <property name="row">0</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label24">
                <property name="visible">1</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Weekly installment:</property>
                <property name="row">1</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_current_start_week">
                <property name="visible">1</property>
                <property name="xalign">0</property>
                <property name="row">0</property>
                <property name="column">1</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_current_weekly_installment">
                <property name="visible">1</property>
                <property name="xalign">0</property>
                <property name="row">1</property>
                <property name="column">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator5">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="height-request">10</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label25">
            <property name="visible">1</property>
            <property name="xalign">0</property>
            <property name="label" translatable="yes">New settings:</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="table1">
            <property name="visible">1</property>
            <property name="column-spacing">10</property>
            <property name="row-spacing">5</property>
            <child>
              <object class="GtkLabel" id="label17">
                <property name="visible">1</property>
                <property name="xalign">1</property>
                <property name="label" translatable="yes">Start in week</property>
                <property name="row">0</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label18">
                <property name="visible">1</string>
                <property name="xalign">1</property>
                <property name="label" translatable="yes">Weekly installment</property>
                <property name="row">1</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_calculate_installment">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Calculate weekly installment</property>
                <property name="icon-name">gtk-execute</property>
                <property name="use-underline">1</property>
                <property name="row">0</property>
                <property name="column">2</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_calculate_start_week">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Calculate start week</property>
                <property name="icon-name">gtk-execute</property>
                <property name="use-underline">1</property>
                <property name="row">1</property>
                <property name="column">2</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_start_week">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">week_adjustment</property>
                <property name="climb-rate">1</property>
                <property name="row">0</property>
                <property name="column">1</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_weekly_installment">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">installment_adjustment</property>
                <property name="climb-rate">1</property>
                <property name="row">1</property>
                <property name="column">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator6">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="height-request">10</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox11">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <child>
              <object class="GtkButton" id="button_constants_save">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Save to file</property>
                <property name="icon-name">gtk-save</property>
                <signal name="clicked" handler="on_button_constants_save_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_constants_reload">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Reload from file</property>
                <property name="icon-name">gtk-refresh</property>
                <signal name="clicked" handler="on_button_constants_reload_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_constants_close">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Close</property>
                <property name="icon-name">gtk-close</property>
                <property name="tooltip-text" translatable="yes">Esc</property>
                <signal name="clicked" handler="on_button_constants_close_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <object class="GtkAdjustment" id="AutosaveInterval_adjustment">
      <property name="upper">20</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="autosave_files_adjustment">
      <property name="upper">100</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="end_of_contract_adjustment">
      <property name="upper">24</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="live_game_speed_adjustment">
      <property name="upper">40</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="live_game_verbose_adjustment">
      <property name="upper">7</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="default_wager_adjustment">
      <property name="upper">25000</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="default_recreation_adjustment">
      <property name="upper">10</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="player_attribute_precision_adjustment">
      <property name="upper">3</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
    <object class="GtkAdjustment" id="player_list_refresh_rate_adjustment">
      <property name="upper">100</property>
      <property name="step-increment">1</property>
      <property name="page-increment">10</property>
    </object>
  </template>
</interface>
