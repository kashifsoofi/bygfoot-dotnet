<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name constants.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_constants">
    <property name="default-width">650</property>
    <property name="default-height">600</property>
    <signal name="close-request" handler="on_window_constants_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox12">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkNotebook" id="notebook_constants">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow1">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_integer">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label50">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Integer</property>
              </object>
              <packing>
                <property name="position">0</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow2">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_float">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label51">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Float</property>
              </object>
              <packing>
                <property name="position">1</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow3">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_string">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="position">2</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label52">
                <property name="visible">1</property>
                <property name="label" translatable="yes">String</property>
              </object>
              <packing>
                <property name="position">2</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow4">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_app">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="position">3</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label53">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Appearance</property>
              </object>
              <packing>
                <property name="position">3</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator9">
            <property name="height-request">10</property>
            <property name="visible">1</property>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_save">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Save to file</property>
            <property name="icon-name">gtk-save</property>
            <signal name="clicked" handler="on_button_constants_save_clicked"/>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_reload">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Reload from file</property>
            <property name="icon-name">gtk-refresh</property>
            <signal name="clicked" handler="on_button_constants_reload_clicked"/>
          </object>
          <packing>
            <property name="position">3</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_close">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Close</property>
            <property name="icon-name">gtk-close</property>
            <property name="tooltip-text" translatable="yes">Esc</property>
            <signal name="clicked" handler="on_button_constants_close_clicked"/>
          </object>
          <packing>
            <property name="position">4</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="AutosaveInterval_adjustment">
    <property name="upper">20</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="autosave_files_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="end_of_contract_adjustment">
    <property name="upper">24</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="live_game_speed_adjustment">
    <property name="upper">40</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="live_game_verbose_adjustment">
    <property name="upper">7</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="default_wager_adjustment">
    <property name="upper">25000</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="default_recreation_adjustment">
    <property name="upper">10</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="player_attribute_precision_adjustment">
    <property name="upper">3</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="player_list_refresh_rate_adjustment">
    <property name="upper">100</property>
    <property name="step-increment">1</property>
    <property name="page-increment">10</property>
  </object>
</interface>
