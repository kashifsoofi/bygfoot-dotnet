<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name file_chooser.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="FileChooserWindow" parent="GtkWindow">
    <property name="title" translatable="yes">Choose file</property>
    <property name="default-width">550</property>
    <property name="default-height">600</property>
    <property name="modal">1</property>
    <child>
      <object class="GtkBox" id="vbox_file_chooser">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkLabel" id="label_file_chooser_title">
            <property name="visible">1</property>
            <property name="label" translatable="yes">Select a file</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox_file_chooser">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_file_chooser_cancel">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="label" translatable="yes">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_file_chooser_open">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="label" translatable="yes">Open</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
