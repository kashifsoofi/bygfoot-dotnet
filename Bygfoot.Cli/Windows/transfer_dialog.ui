<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name transfer_dialog.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_transfer_dialog">
    <property name="default-width">450</property>
    <property name="default-height">350</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_transfer_dialog_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox26">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkImage" id="image14">
            <property name="visible">1</property>
            <property name="icon-name">gtk-dialog-question</property>
            <property name="icon-size">6</property>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkLabel" id="label_transfer_dialog">
            <property name="visible">1</property>
            <property name="wrap">1</property>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="hbox25">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_transfer_yes">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Yes</property>
                <property name="icon-name">gtk-yes</property>
                <property name="tooltip-text" translatable="yes">Return</property>
                <signal name="clicked" handler="on_button_transfer_yes_clicked"/>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_transfer_no">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">No</property>
                <property name="icon-name">gtk-no</property>
                <signal name="clicked" handler="on_button_transfer_no_clicked"/>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_transfer_later">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Decide later</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-go-forward</property>
                <property name="tooltip-text" translatable="yes">Esc</property>
                <signal name="clicked" handler="on_button_transfer_later_clicked"/>
              </object>
              <packing>
                <property name="position">2</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
