                                <property name="use-underline">1</property>
                                <property name="draw-as-radio">1</property>
                                <property name="group">menu_all_out_defend</property>
                                <signal name="button-release-event" handler="on_menu_team_button_release_event"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkRadioMenuItem" id="menu_attack">
                                <property name="visible">1</property>
                                <property name="label">Attack</property>
                                <property name="use-underline">1</property>
                                <property name="draw-as-radio">1</property>
                                <property name="group">menu_all_out_defend</property>
                                <signal name="button-release-event" handler="on_menu_team_button_release_event"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkRadioMenuItem" id="menu_all_out_attack">
                                <property name="visible">1</property>
