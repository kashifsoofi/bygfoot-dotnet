<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name main.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="main_window">
    <property name="visible">1</property>
    <property name="default-width">300</property>
    <property name="default-height">600</property>
    <property name="icon">pixmaps/bygfoot_icon.png</property>
    <signal name="close-request" handler="on_button_quit_clicked"/>
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkMenuBar" id="menubar1">
            <property name="visible">1</property>
            <child>
              <object class="GtkMenuItem" id="menu_file">
                <property name="visible">1</property>
                <property name="label">_File</property>
                <property name="use-underline">1</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_file_menu">
                    <child>
                      <object class="GtkImageMenuItem" id="menu_new">
                        <property name="label">New</property>
                        <property name="visible">1</property>
                        <property name="image">image43</property>
                        <signal name="activate" handler="on_menu_new_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_open">
                        <property name="label">Open</property>
                        <property name="visible">1</property>
                        <property name="image">image44</property>
                        <signal name="activate" handler="on_menu_open_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_load_last_save">
                        <property name="label">Load last save</property>
                        <property name="visible">1</property>
                        <property name="image">image5</property>
                        <signal name="activate" handler="on_menu_load_last_save_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_save">
                        <property name="label">Save</property>
                        <property name="visible">1</property>
                        <property name="image">image45</property>
                        <signal name="activate" handler="on_menu_save_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_save_as">
                        <property name="label">Save As</property>
                        <property name="visible">1</property>
                        <property name="image">image46</property>
                        <signal name="activate" handler="on_menu_save_as_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="trennlinie1">
                        <property name="visible">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_quit">
                        <property name="label">Quit</property>
                        <property name="visible">1</property>
                        <property name="use-underline">1</property>
                        <signal name="activate" handler="on_menu_quit_activate"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_options">
                <property name="visible">1</property>
                <property name="label">_Options</property>
                <property name="use-underline">1</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_options_menu">
                    <child>
                      <object class="GtkImageMenuItem" id="menu_preferences">
                        <property name="label">Preferences</property>
                        <property name="visible">1</property>
                        <property name="image">image47</property>
                        <signal name="activate" handler="on_menu_preferences_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="trennlinie7">
                        <property name="visible">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="menu_job_offers">
                        <property name="visible">1</property>
                        <property name="label">Job offers</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                        <signal name="button-press-event" handler="on_menu_check_button_press_event"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="menu_live_game">
                        <property name="visible">1</property>
                        <property name="label">Live game</property>
                        <property name="use-underline">1</property>
                        <signal name="button-press-event" handler="on_menu_check_button_press_event"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckMenuItem" id="menu_overwrite">
                        <property name="visible">1</property>
                        <property name="label">Overwrite</property>
                        <property name="use-underline">1</property>
                        <property name="active">1</property>
                        <signal name="button-press-event" handler="on_menu_check_button_press_event"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparatorMenuItem" id="trennlinie14">
                        <property name="visible">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_save_window_geometry">
                        <property name="label">Save window geometry</property>
                        <property name="visible">1</property>
                        <property name="tooltip-text">Save window size, position and vertical divider</property>
                        <property name="image">image4</property>
                        <signal name="activate" handler="on_menu_save_window_geometry_activate"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_figures">
                <property name="visible">1</property>
                <property name="label">F_igures</property>
                <property name="use-underline">1</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_figures_menu">
                    <child>
                      <object class="GtkImageMenuItem" id="menu_fixtures_week">
                        <property name="label">Fixtures (week)</property>
                        <property name="visible">1</property>
                        <property name="image">image1</property>
                        <signal name="activate" handler="on_menu_fixtures_week_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_fixtures">
                        <property name="label">Fixtures (competitions)</property>
                        <property name="visible">1</property>
                        <property name="image">image2</property>
                        <signal name="activate" handler="on_menu_fixtures_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_tables">
                        <property name="label">Tables</property>
                        <property name="visible">1</property>
                        <property name="image">image3</property>
                        <signal name="activate" handler="on_menu_tables_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_my_league_results">
                        <property name="label">My league results</property>
                        <property name="visible">1</property>
                        <property name="image">image6</property>
                        <signal name="activate" handler="on_menu_my_league_results_activate"/>
                      </object>
                    </child>
                    <child>
                      <object class="GtkImageMenuItem" id="menu_season_results">
                        <property name="label">Season results</property>
                        <property name="visible">1</property>
                        <property name="image">image7</property>
                        <signal name="activate" handler="on_menu_season_results_activate"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkMenuItem" id="menu_team">
                <property name="visible">1</property>
                <property name="label">_Team</property>
                <property name="use-underline">1</property>
                <child type="submenu">
                  <object class="GtkMenu" id="menu_team_menu">
                    <child>
                      <object class="GtkImageMenuItem" id="menu_playing_style">
                        <property name="label">Playing style</property>
                        <property name="visible">1</property>
                        <property name="image">image8</property>
                        <child type="submenu">
                          <object class="GtkMenu" id="menu_playing_style_menu">
                            <child>
                              <object class="GtkRadioMenuItem" id="menu_all_out_defend">
                                <property name="visible">1</property>
                                <property name="label">All Out Defend</property>
                                <property name="use-underline">1</property>
                                <property name="draw-as-radio">1</property>
                                <signal name="button-release-event" handler="on_menu_team_button_release_event"/>
                              </object>
                            </child>
                            <child>
                              <object class="GtkRadioMenuItem" id="menu_defend">
                                <property name="visible">1</property>
                                <property name="label">Defend</property>
                                <property name="use-underline">1</property>
                                <property name="draw-as-radio">1</property>
                                <property name="group">menu_all_out_defend</property>
                                <signal name="button-release-event" handler="on_menu_team_button_release_event"/>
                              </object>
