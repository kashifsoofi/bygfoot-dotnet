<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name font_sel.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="FontSelWindow" parent="GtkFontChooserDialog">
    <property name="default-width">550</property>
    <property name="default-height">600</property>
    <property name="title" translatable="yes">Select font</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_font_sel_close_request"/>
    <child>
      <object class="GtkBox" id="hbox_font_sel">
        <property name="visible">1</property>
        <property name="orientation">0</property>
        <property name="spacing">6</property>
        <child>
          <object class="GtkFontChooserWidget" id="font_sel">
            <property name="visible">1</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="action_area_font_sel">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkButton" id="button_font_sel_cancel">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Cancel</property>
                <signal name="clicked" handler="on_button_font_sel_cancel_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_font_sel_apply">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Apply</property>
                <signal name="clicked" handler="on_button_font_sel_apply_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_font_sel_ok">
                <property name="visible">1</property>
                <property name="label" translatable="yes">OK</property>
                <signal name="clicked" handler="on_button_font_sel_ok_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
