<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name news.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="NewsWindow" parent="GtkWindow">
    <property name="title" translatable="yes">Bygfoot News</property>
    <property name="default-width">700</property>
    <property name="default-height">600</property>
    <signal name="close-request" handler="on_window_news_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox6">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <child>
          <object class="GtkScrolledWindow" id="scrolledwindow3">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="hscrollbar-policy">automatic</property>
            <property name="vscrollbar-policy">automatic</property>
            <child>
              <object class="GtkListView" id="treeview_news">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator8">
            <property name="height-request">10</property>
            <property name="visible">1</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_news_close">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Close</property>
            <property name="icon-name">gtk-close</property>
            <property name="tooltip-text" translatable="yes">Esc</property>
            <signal name="clicked" handler="on_button_news_close_clicked"/>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
