<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name mmatches.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_mmatches">
    <property name="default-width">600</property>
    <property name="default-height">500</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_mmatches_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox27">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">3</property>
        <child>
          <object class="GtkBox" id="hbox27">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkLabel" id="label54">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Current file</property>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkEntry" id="entry_mm_file">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_mm_file">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Open</property>
                <property name="icon-name">gtk-open</property>
                <property name="tooltip-text" translatable="yes">Open a memorable matches file</property>
                <signal name="clicked" handler="on_button_mm_file_clicked"/>
              </object>
              <packing>
                <property name="position">2</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_mm_reload">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Reload</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-refresh</property>
                <property name="tooltip-text" translatable="yes">Reload matches from file</property>
                <signal name="clicked" handler="on_button_mm_reload_clicked"/>
              </object>
              <packing>
                <property name="position">3</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_mm_import">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Import file</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-paste</property>
                <property name="tooltip-text" translatable="yes">Import the matches from a memorable matches file</property>
                <signal name="clicked" handler="on_button_mm_import_clicked"/>
              </object>
              <packing>
                <property name="position">4</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="scrolledwindow5">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="hscrollbar-policy">automatic</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="shadow-type">in</property>
            <child>
              <object class="GtkTreeView" id="treeview_mmatches">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="enable-search">0</property>
                <signal name="button-press-event" handler="on_treeview_mmatches_button_press_event"/>
              </object>
            </child>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkBox" id="hbox34">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_mm_save_close">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Save and close</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-close</property>
                <property name="tooltip-text" translatable="yes">Save changes to file and close</property>
                <signal name="clicked" handler="on_button_mm_save_close_clicked"/>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_mm_reload_close">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Reload and close</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-refresh</property>
                <property name="tooltip-text" translatable="yes">Reload matches from file and close</property>
                <signal name="clicked" handler="on_button_mm_reload_close_clicked"/>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
