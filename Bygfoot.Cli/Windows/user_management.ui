<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name user_management.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_user_management">
    <property name="default-width">600</property>
    <property name="default-height">550</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_user_management_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox19">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkBox" id="hbox23">
            <property name="visible">1</property>
            <child>
              <object class="GtkBox" id="vbox20">
                <property name="visible">1</property>
                <property name="orientation">1</property>
                <child>
                  <object class="GtkLabel" id="label47">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Users -- click to remove</property>
                  </object>
                  <packing>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow2">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="hscrollbar-policy">automatic</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkTreeView" id="treeview_user_management_users">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="tooltip-text" translatable="yes">Click on a user to remove him from the game.</property>
                        <signal name="button-press-event" handler="on_treeview_user_management_users_button_press_event"/>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkBox" id="vbox21">
                <property name="visible">1</property>
                <property name="orientation">1</property>
                <child>
                  <object class="GtkLabel" id="label46">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Available teams</property>
                  </object>
                  <packing>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="scrolledwindow3">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="hscrollbar-policy">automatic</property>
                    <property name="vscrollbar-policy">automatic</property>
                    <property name="shadow-type">in</property>
                    <child>
                      <object class="GtkTreeView" id="treeview_user_management_teams">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <signal name="row-activated" handler="on_treeview_user_management_teams_row_activated"/>
                      </object>
                    </child>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkHBox" id="hbox21">
            <property name="visible">1</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkEntry" id="entry_user_management">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <signal name="activate" handler="on_entry_user_management_activate"/>
              </object>
              <packing>
                <property name="position">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkButton" id="button_user_management_add">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Add user</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-add</property>
                <signal name="clicked" handler="on_button_user_management_add_clicked"/>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator9">
            <property name="width-request">1</property>
            <property name="height-request">10</property>
            <property name="visible">1</property>
          </object>
          <packing>
            <property name="position">2</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_user_management_close">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Close</property>
            <property name="icon-name">gtk-close</property>
            <signal name="clicked" handler="on_button_user_management_close_clicked"/>
          </object>
          <packing>
            <property name="position">3</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
