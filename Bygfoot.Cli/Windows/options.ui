                        <property name="adjustment">player_list_refresh_rate_adjustment</property>
                        <property name="climb-rate">1</property>
                        <property name="numeric">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="entry_font_name">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="tooltip-text" translatable="yes">Font used in treeviews</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkComboBox" id="combobox_languages">
                        <property name="visible">1</property>
                      </object>
                    </child>
                  </object>
                </child>
                <packing>
                  <property name="position">2</property>
                </packing>
              </object>
            </child>
            <packing>
              <property name="tab-fill">False</property>
            </packing>
            <child type="tab">
              <object class="GtkLabel" id="label1">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Global</property>
              </object>
            </child>
            <child>
