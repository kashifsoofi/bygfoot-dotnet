<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name options.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_options">
    <signal name="close-request" handler="on_window_options_delete_event"/>
    <child>
      <object class="GtkVBox" id="vbox1">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkNotebook" id="notebook1">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkHBox" id="hbox2">
                <property name="visible">1</property>
                <child>
                  <object class="GtkVBox" id="vbox3">
                    <property name="visible">1</property>
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_conf_quit">
                        <property name="label" translatable="yes">Confirm quit when not saved</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether to show a confirmation popup when you press quit and the game state is not saved</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">0</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_conf_unfit">
                        <property name="label" translatable="yes">Confirm when unfit</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether to show a confirmation popup if a user team has an injured or banned player in the startup formation</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">1</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_save_overwrite">
                        <property name="label" translatable="yes">Save overwrites</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether 'Save' overwrites the current save file or pops up a 'Save as' window</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">2</property>
                    </packing>
                    <child>
                      <object class="GtkHSeparator" id="hseparator5">
                        <property name="width-request">1</property>
                        <property name="height-request">10</property>
                        <property name="visible">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">3</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_maximize">
                        <property name="label" translatable="yes">Maximize main window</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether game starts with a maximized main window (doesn't work with all window managers)</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">4</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_pref_mess">
                        <property name="label" translatable="yes">Prefer messages</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether to show warnings and such in the message area in the main window when possible</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">5</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_show_progress_pics">
                        <property name="label" translatable="yes">Show progressbar pictures</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether to show pictures on top of the progressbar when loading/saving or calculating results</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">6</property>
                    </packing>
                    <child>
                      <object class="GtkHSeparator" id="hseparator6">
                        <property name="width-request">1</property>
                        <property name="height-request">10</property>
                        <property name="visible">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">7</property>
                    </packing>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_skip">
                        <property name="label" translatable="yes">Skip weeks without user matches</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">If checked, weeks without user teams playing are calculated automatically (without the user having to press 'New week')</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <packing>
                      <property name="position">8</property>
                    </packing>
                  </object>
                </child>
                <packing>
                  <property name="position">0</property>
                </packing>
                <child>
                  <object class="GtkVSeparator" id="vseparator1">
                    <property name="width-request">10</property>
                    <property name="height-request">1</property>
                    <property name="visible">1</property>
                  </object>
                </child>
                <packing>
                  <property name="position">1</property>
                </packing>
                <child>
                  <object class="GtkTable" id="table1">
                    <property name="visible">1</property>
                    <property name="n-rows">6</property>
                    <property name="n-columns">2</property>
                    <property name="column-spacing">5</property>
                    <property name="row-spacing">1</property>
                    <child>
                      <object class="GtkHBox" id="hbox3">
                        <property name="visible">1</property>
                        <child>
                          <object class="GtkLabel" id="label6">
                            <property name="visible">1</property>
                            <property name="label" translatable="yes">Autosave interval </property>
                          </object>
                        </child>
                        <packing>
                          <property name="position">0</property>
                        </packing>
                        <child>
                          <object class="GtkSpinButton" id="spinbutton_autosave">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="tooltip-text" translatable="yes">How often the game is saved automatically</property>
                            <property name="adjustment">AutosaveInterval_adjustment</property>
                            <property name="climb-rate">1</property>
                            <property name="numeric">1</property>
                          </object>
                        </child>
                        <packing>
                          <property name="position">1</property>
                        </packing>
                        <child>
                          <object class="GtkLabel" id="label36">
                            <property name="visible">1</property>
                            <property name="label" translatable="yes"> Autosave files </property>
                          </object>
                        </child>
                        <packing>
                          <property name="position">2</property>
                        </packing>
                        <child>
                          <object class="GtkSpinButton" id="spinbutton_autosave_files">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="tooltip-text" translatable="yes">How many files the autosave uses</property>
                            <property name="adjustment">autosave_files_adjustment</property>
                            <property name="climb-rate">1</property>
                          </object>
                        </child>
                        <packing>
                          <property name="position">3</property>
                        </packing>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label7">
                        <property name="visible">1</property>
                        <property name="xalign">1</property>
                        <property name="label" translatable="yes">Player attribute precision</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label8">
                        <property name="visible">1</property>
                        <property name="xalign">1</property>
                        <property name="label" translatable="yes">Player list refresh rate</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label10">
                        <property name="visible">1</property>
                        <property name="xalign">1</property>
                        <property name="label" translatable="yes">Constants file</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="button_font_name">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Font used in treeviews</property>
                        <signal name="clicked" handler="on_button_font_name_clicked"/>
                        <child>
                          <object class="GtkAlignment" id="alignment1">
                            <property name="visible">1</property>
                            <child>
                              <object class="GtkHBox" id="hbox7">
                                <property name="visible">1</property>
                                <property name="spacing">2</property>
                                <child>
                                  <object class="GtkImage" id="image1">
                                    <property name="visible">1</property>
                                  </object>
                                </child>
                                <packing>
                                  <property name="position">0</property>
                                </packing>
                                <child>
                                  <object class="GtkLabel" id="label34">
                                    <property name="visible">1</property>
                                    <property name="label" translatable="yes">Font name</property>
                                    <property name="use-underline">1</property>
                                  </object>
                                </child>
                                <packing>
                                  <property name="position">1</property>
                                </packing>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkHBox" id="hbox8">
                        <property name="visible">1</property>
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkEntry" id="entry_constants_file">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="tooltip-text" translatable="yes">File containing settings which determine a lot of aspects of the game behaviour. DON'T CHANGE THIS UNLESS YOU REALLY KNOW WHAT YOU ARE DOING.</property>
                          </object>
                        </child>
                        <packing>
                          <property name="position">0</property>
                        </packing>
                        <child>
                          <object class="GtkButton" id="button_reload_constants">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="receives-default">0</property>
                            <property name="tooltip-text" translatable="yes">Reload the constants file</property>
                            <signal name="clicked" handler="on_button_reload_constants_clicked"/>
                            <child>
                              <object class="GtkAlignment" id="alignment2">
                                <property name="visible">1</property>
                                <child>
                                  <object class="GtkHBox" id="hbox9">
                                    <property name="visible">1</property>
                                    <property name="spacing">2</property>
                                    <child>
                                      <object class="GtkImage" id="image2">
                                        <property name="visible">1</property>
                                      </object>
                                    </child>
                                    <packing>
                                      <property name="position">0</property>
                                    </packing>
                                    <child>
                                      <object class="GtkLabel" id="label35">
                                        <property name="visible">1</property>
                                        <property name="label" translatable="yes">Reload</property>
                                        <property name="use-underline">1</property>
                                      </object>
                                    </child>
                                    <packing>
                                      <property name="position">1</property>
                                    </packing>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <packing>
                          <property name="position">1</property>
                        </packing>
                        <child>
                          <object class="GtkButton" id="button_edit_constants">
                            <property name="visible">1</property>
                            <property name="can-focus">1</property>
                            <property name="receives-default">0</property>
                            <property name="tooltip-text" translatable="yes">Edit the constants used in the game</property>
                            <signal name="clicked" handler="on_button_edit_constants_clicked"/>
                            <child>
                              <object class="GtkAlignment" id="alignment3">
                                <property name="visible">1</property>
                                <child>
                                  <object class="GtkHBox" id="hbox19">
                                    <property name="visible">1</property>
                                    <property name="spacing">2</property>
                                    <child>
                                      <object class="GtkImage" id="image3">
                                        <property name="visible">1</property>
                                        </object>
                                    </child>
                                    <packing>
                                      <property name="position">0</property>
                                    </packing>
                                    <child>
                                      <object class="GtkLabel" id="label49">
                                        <property name="visible">1</property>
                                        <property name="label" translatable="yes">Edit</property>
                                        <property name="use-underline">1</property>
                                      </object>
                                    </child>
                                    <packing>
                                      <property name="position">1</property>
                                    </packing>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <packing>
                          <property name="position">2</property>
                        </packing>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="label40">
                        <property name="visible">1</property>
                        <property name="xalign">1</property>
                        <property name="label" translatable="yes">Language</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkCheckButton" id="checkbutton_autosave">
                        <property name="label" translatable="yes">Autosave</property>
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="receives-default">0</property>
                        <property name="tooltip-text" translatable="yes">Whether to automatically save the game regularly</property>
                        <property name="use-underline">1</property>
                        <property name="draw-indicator">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spinbutton_precision">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
                        <property name="tooltip-text" translatable="yes">How many digits after the comma there are for skill etc.</property>
                        <property name="adjustment">player_attribute_precision_adjustment</property>
                        <property name="climb-rate">1</property>
                        <property name="numeric">1</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSpinButton" id="spinbutton_refresh">
                        <property name="visible">1</property>
                        <property name="can-focus">1</property>
