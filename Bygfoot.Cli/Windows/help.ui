<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name help.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_help">
    <property name="default-width">400</property>
    <property name="default-height">400</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_help_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox23">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">3</property>
        <child>
          <object class="GtkNotebook" id="notebook1">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkVBox" id="vbox24">
                <property name="visible">1</property>
                <property name="orientation">1</property>
                <property name="spacing">5</property>
                <child>
                  <object class="GtkImage" id="image12">
                    <property name="visible">1</property>
                    <property name="pixbuf">pixmaps/bygfoot_splash2.png</property>
                  </object>
                  <packing>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="label_about">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="use-markup">1</property>
                    <property name="justify">1</property>
                    <property name="selectable">1</property>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label49">
                <property name="visible">1</property>
                <property name="label" translatable="yes">About</property>
              </object>
              <packing>
                <property name="position">0</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow4">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <property name="shadow-type">in</property>
                <child>
                  <object class="GtkTreeView" id="treeview_contributors">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
              <packing>
                <property name="position">1</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label_contributors">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Contributors</property>
              </object>
              <packing>
                <property name="position">1</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child>
              <object class="GtkVBox" id="vbox25">
                <property name="visible">1</property>
                <property name="orientation">1</property>
                <property name="spacing">3</property>
                <child>
                  <object class="GtkImage" id="image13">
                    <property name="visible">1</property>
                    <property name="icon-name">gtk-help</property>
                    <property name="icon-size">6</property>
                  </object>
                  <packing>
                    <property name="position">0</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="label_help_text1">
                    <property name="visible">1</property>
                    <property name="wrap">1</property>
                  </object>
                  <packing>
                    <property name="position">1</property>
                  </packing>
                </child>
                <child>
                  <object class="GtkLabel" id="label_help_text2">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                    <property name="wrap">1</property>
                    <property name="selectable">1</property>
                  </object>
                  <packing>
                    <property name="position">2</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="position">2</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label51">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Help</property>
              </object>
              <packing>
                <property name="position">2</property>
                <property name="tab-fill">0</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="position">0</property>
          </packing>
        </child>
        <child>
          <object class="GtkButton" id="button_help_close">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="receives-default">0</property>
            <property name="label" translatable="yes">Close</property>
            <property name="icon-name">gtk-close</property>
            <property name="tooltip-text" translatable="yes">Esc</property>
            <signal name="clicked" handler="on_button_help_close_clicked"/>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
