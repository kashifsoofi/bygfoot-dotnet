<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name splash.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="SplashWindow" parent="GtkWindow">
    <property name="default-width">500</property>
    <property name="default-height">400</property>
    <!-- <signal name="close-request" handler="on_window_splash_delete_event"/> -->
    <child>
      <object class="GtkBox" id="vbox2">
        <property name="visible">1</property>
        <property name="orientation">vertical</property>
        <property name="spacing">3</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <property name="margin-top">5</property>
        <child>          
          <object class="GtkNotebook" id="notebook1">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <child>
              <object class="GtkImage" id="image1">
                <property name="visible">1</property>
                <property name="file">support_files/pixmaps/bygfoot_splash.png</property>
                <property name="width-request">345</property>
                <property name="height-request">230</property>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label2">
                <property name="visible">1</property>
                <property name="label">     </property>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow2">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkListView" id="treeview_splash_contributors">
                    <property name="visible">1</property>
                    <property name="can-focus">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label3">
                <property name="visible">1</property>
                <property name="label" translatable="yes">Contributors</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator3">
            <property name="width-request">1</property>
            <property name="height-request">10</property>
            <property name="visible">1</property>
            <property name="orientation">0</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="vbox3">
            <property name="visible">1</property>
            <property name="orientation">1</property>
            <child>
              <object class="GtkBox" id="hbox2">
                <property name="visible">1</property>
                <property name="orientation">1</property>
                <property name="spacing">3</property>
                <child>
                  <object class="GtkImage" id="image2">
                    <property name="visible">1</property>
                    <!-- <property name="icon-name">gtk-dialog-info</property> -->
                    <property name="icon-name">dialog-information-symbolic</property>
                    <property name="icon-size">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label4">
                    <property name="visible">1</property>
                    <property name="label" translatable="yes">Did you know?</property>
                    <property name="use-markup">1</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label_splash_hintcounter">
                    <property name="visible">1</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="label_splash_hint">
                <property name="height-request">90</property>
                <property name="visible">1</property>
                <property name="wrap">1</property>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="hbox10">
                <property name="hexpand">True</property>
                <property name="homogeneous">True</property>
                <property name="visible">1</property>
                <property name="spacing">3</property>
                <child>
                  <object class="GtkButton" id="button_splash_hint_back">
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">go-previous-symbolic</property>
                            <!-- <property name="icon-name">gtk-go-back</property> -->
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Previous</property>
                            <property name="use-underline">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="button_splash_hint_next">
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">go-next-symbolic</property>
                            <!-- <property name="icon-name">gtk-go-forward</property> -->
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Next</property>
                            <property name="use-underline">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator4">
            <property name="width-request">1</property>
            <property name="height-request">10</property>
            <property name="visible">1</property>
            <property name="orientation">0</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox3">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_splash_new_game">
                <child>
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-new-symbolic</property>
                        <!-- <property name="icon-name">gtk-new</property> -->
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Start _new game</property>
                        <property name="tooltip-text" translatable="yes">Ctrl-N</property>
                        <property name="use-underline">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_splash_load_game">
                <child>
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-open-symbolic</property>
                        <!-- <property name="icon-name">gtk-open</property> -->
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">_Load game</property>
                        <property name="tooltip-text" translatable="yes">Ctrl-O</property>
                        <property name="use-underline">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_splash_resume_game">
                <child>
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">document-open-recent-symbolic</property>
                        <!-- <property name="icon-name">gtk-revert-to-saved</property> -->
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">_Resume game</property>
                        <property name="tooltip-text" translatable="yes">Ctrl-R</property>
                        <property name="use-underline">1</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_splash_quit">
                <property name="hexpand">True</property>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">2</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">window-close-symbolic</property>
                        <!-- <property name="icon-name">gtk-quit</property> -->
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label" translatable="yes">Quit</property>
                        <property name="tooltip-text" translatable="yes">Esc</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox7">
            <property name="visible">1</property>
            <property name="orientation">1</property>
            <property name="spacing">5</property>
            <child>
              <object class="GtkLabel" id="label_splash_progress">
                <property name="width-request">400</property>
                <property name="visible">1</property>
                <property name="xalign">0</property>
                <property name="label" translatable="yes">Ready</property>
              </object>
            </child>
            <child>
              <object class="GtkProgressBar" id="progressbar_splash">
                <property name="height-request">10</property>
                <property name="visible">1</property>
                <property name="pulse-step">0.1</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
