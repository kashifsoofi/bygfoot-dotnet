<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name contract.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <template class="ContractWindow" parent="GtkWindow">
    <property name="title" translatable="yes">Contract</property>
    <property name="default-width">450</property>
    <property name="default-height">350</property>
    <property name="modal">1</property>
    <signal name="close-request" handler="on_window_contract_delete_event"/>
    <child>
      <object class="GtkBox" id="vbox18">
        <property name="visible">1</property>
        <property name="orientation">1</property>
        <property name="spacing">3</property>
        <child>
          <object class="GtkImage" id="image9">
            <property name="visible">1</property>
            <property name="icon-name">gtk-new</property>
            <property name="icon-size">6</property>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="label_contract">
            <property name="visible">1</property>
            <property name="wrap">1</property>
          </object>
        </child>
        <child>
          <object class="GtkGrid" id="table1">
            <property name="visible">1</property>
            <property name="column-spacing">3</property>
            <child>
              <object class="GtkCheckButton" id="radiobutton_contract1">
                <property name="label" translatable="yes">1 year</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="use-underline">1</property>
                <property name="draw-indicator">1</property>
                <property name="row">0</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="radiobutton_contract2">
                <property name="label" translatable="yes">2 years</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="use-underline">1</property>
                <property name="active">1</property>
                <property name="draw-indicator">1</property>
                <property name="row">1</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="radiobutton_contract3">
                <property name="label" translatable="yes">3 years</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="use-underline">1</property>
                <property name="drawindicator">1</property>
                <property name="row">2</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkCheckButton" id="radiobutton_contract4">
                <property name="label" translatable="yes">4 years</property>
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="use-underline">1</property>
                <property name="draw-indicator">1</property>
                <property name="row">3</property>
                <property name="column">0</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_contract1">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjustment1</property>
                <property name="row">0</property>
                <property name="column">1</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_contract2">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjustment2</property>
                <property name="row">1</property>
                <property name="column">1</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_contract3">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjustment3</property>
                <property name="row">2</property>
                <property name="column">1</property>
              </object>
            </child>
            <child>
              <object class="GtkSpinButton" id="spinbutton_contract4">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="adjustment">adjustment4</property>
                <property name="row">3</property>
                <property name="column">1</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator8">
            <property name="visible">1</property>
            <property name="orientation">0</property>
            <property name="height-request">10</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="hbox19">
            <property name="visible">1</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkButton" id="button_contract_offer">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Make offer</property>
                <property name="use-underline">1</property>
                <property name="icon-name">gtk-apply</property>
                <signal name="clicked" handler="on_button_contract_offer_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="button_contract_cancel">
                <property name="visible">1</property>
                <property name="can-focus">1</property>
                <property name="receives-default">0</property>
                <property name="label" translatable="yes">Cancel</property>
                <property name="icon-name">gtk-cancel</property>
                <signal name="clicked" handler="on_button_contract_cancel_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
