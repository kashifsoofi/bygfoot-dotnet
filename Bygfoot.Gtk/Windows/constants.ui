<?xml version='1.0' encoding='UTF-8'?>
<!-- interface-name window_constants.ui -->
<interface>
  <requires lib="gtk" version="4.12"/>
  <object class="GtkWindow" id="window_constants">
    <property name="default-height">600</property>
    <property name="default-width">650</property>
    <property name="window-position">center</property>
    <child>
      <object class="GtkBox" id="vbox12">
        <property name="margin-bottom">5</property>
        <property name="margin-end">5</property>
        <property name="margin-start">5</property>
        <property name="margin-top">5</property>
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <child>
          <object class="GtkNotebook" id="notebook_constants">
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow1">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_integer"/>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label50">
                <property name="label" translatable="yes">Integer</property>
              </object>
              <packing>
                <property name="tab-fill">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow2">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_float"/>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label51">
                <property name="label" translatable="yes">Float</property>
              </object>
              <packing>
                <property name="tab-fill">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow3">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_string"/>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label52">
                <property name="label" translatable="yes">String</property>
              </object>
              <packing>
                <property name="tab-fill">False</property>
              </packing>
            </child>
            <child>
              <object class="GtkScrolledWindow" id="scrolledwindow4">
                <property name="hscrollbar-policy">automatic</property>
                <property name="vscrollbar-policy">automatic</property>
                <child>
                  <object class="GtkTreeView" id="treeview_constants_app"/>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel" id="label53">
                <property name="label" translatable="yes">Appearance</property>
              </object>
              <packing>
                <property name="tab-fill">False</property>
              </packing>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator" id="hseparator9">
            <property name="height-request">10</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_save">
            <child>
              <object class="GtkBox" id="hbox22">
                <property name="halign">center</property>
                <property name="spacing">2</property>
                <child>
                  <object class="GtkImage" id="image6">
                    <property name="icon-name">document-save-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label56">
                    <property name="label" translatable="yes">Save to file</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_reload">
            <child>
              <object class="GtkBox" id="hbox20">
                <property name="halign">center</property>
                <property name="spacing">2</property>
                <child>
                  <object class="GtkImage" id="image4">
                    <property name="icon-name">view-refresh-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label54">
                    <property name="label" translatable="yes">Reload from file</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button_constants_close">
            <accelerator key="Escape" signal="clicked"/>
            <child>
              <object class="GtkBox" id="hbox21">
                <property name="halign">center</property>
                <property name="spacing">2</property>
                <child>
                  <object class="GtkImage" id="image5">
                    <property name="icon-name">window-close-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label55">
                    <property name="label" translatable="yes">Close</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
