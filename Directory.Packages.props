    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="TUnit" Version="1.86.6" />
    <PackageVersion Include="Tunit.Analyzers" Version="0.1.984" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
  </ItemGroup>
</Project>
